# Copy to .env.local and fill in values.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Neon connection string for the app (Neon console → Connect, pooled).
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Separate Neon branch for `npm run test:db`. It is truncated and reseeded on
# every run, so it must NOT be the same database as DATABASE_URL.
TEST_DATABASE_URL=
