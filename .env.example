# Copy to .env.local and fill in values.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Neon connection string for the app (Neon console → Connect, pooled).
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Separate Neon branch for `npm run test:db`. It is truncated and reseeded on
# every run, so it must NOT be the same database as DATABASE_URL.
TEST_DATABASE_URL=

# Better Auth. Secret: at least 32 random characters (e.g. `openssl rand -base64 32`).
BETTER_AUTH_SECRET=
# Public base URL of the app (used for auth callbacks and cookie origin checks).
BETTER_AUTH_URL=http://localhost:3000

# Stripe (use a sandbox). Prefer a restricted key (rk_…) with write access to
# Checkout Sessions. Webhook secret: from `stripe listen` locally, or the
# Dashboard endpoint for /api/stripe/webhook.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Bearer token for /api/cron/release-expired (Vercel Cron sends it
# automatically when set in the project). Any long random string, e.g.
# `openssl rand -hex 32`.
CRON_SECRET=
